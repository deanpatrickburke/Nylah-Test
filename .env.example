# Supabase config for couple-fridge-phone
# Primary live-sync store: TABLE couple_data, ROW_ID/token ash-ciaran-2026
# Copy to .env.local or set via Netlify env vars - Vite reads VITE_*
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: override version check URL (same-origin by default)
# VITE_VERSION_URL=/version.json
# Legacy fallback (Netlify Blobs / Apps Script) - optional, keeps Sheet backup
# VITE_APPS_SCRIPT_URL=/.netlify/functions/couple-data

# Notes:
# - localStorage keys couple_v1_supabase_url / couple_v1_supabase_anon (JSON stringified) also work for on-device override without rebuild
# - See supabase-init.sql for table + RLS + realtime setup
# - TOKEN baked as DEFAULT_TOKEN=ash-ciaran-2026 in App.tsx, used as ROW_ID for Supabase and for legacy /?token=
